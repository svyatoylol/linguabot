# ========================================================
# Переменные окружения для развертывания LinguaBot
# Скопируйте этот файл в .env и укажите ваши ключи API
# ========================================================

# База данных PostgreSQL
POSTGRES_DB=linguabot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgre_secure_password_2026

# Ключ Google Gemini API (для диалогов и разбора речи)
# Получить бесплатный ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Ключ Groq API для Whisper STT (распознавание аудио)
# Получить бесплатный ключ: https://console.groq.com/keys
GROK_API_KEY=your_groq_api_key_here

# Порт приложения
APP_PORT=5000
